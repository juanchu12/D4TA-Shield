# D4TA Shield — environment template
# Copy to infra/.env for docker compose

# --- Shared secrets ---
APP_SECRET=change_me_app_secret_32_chars_min
JWT_PASSPHRASE=change_me_jwt_passphrase
INTERNAL_TOKEN=dev-internal-token-change-me
OPENAI_API_KEY=sk-your-openai-key

# --- PostgreSQL (shield-db) ---
POSTGRES_USER=shield
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=shield

# --- Frontend build arg (Option B) / Cloudflare env (Option A) ---
NEXT_PUBLIC_API_URL=https://api-shield.yourd4ta.com

# --- CORS (Symfony) ---
# Quote the regex — unquoted parentheses break `source .env` in bash
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|shield\.yourd4ta\.com)(:[0-9]+)?$'

# --- Cloudflare Pages (Option A) ---
# CF_PAGES_PROJECT=shield
# CF_API_TOKEN=

# --- Docker registry (CI deploy to Proxmox) ---
# REGISTRY=registry.yourd4ta.com
# REGISTRY_USER=
# REGISTRY_PASSWORD=
